[Unit]
Description=Freenove smart-car server (TCP command port 12345)
# The net-watchdog can reboot the Pi on its own; without this unit the chassis
# came back dead and stayed dead until someone noticed.
# Port 8090 (the camera) is served by aurora-camera.service now, NOT here -
# Main.py runs with -nt (no -m) so its Camera_Server never starts mjpg-streamer.
After=network.target
Wants=network.target

[Service]
Type=simple
User=astra
Group=astra
WorkingDirectory=/home/astra/Freenove_Three-wheeled_Smart_Car_Kit_for_Raspberry_Pi/Server
# Main.py unconditionally builds a QApplication; offscreen removes its dependency
# on a live X display, which is why it used to fail after every reboot.
Environment=QT_QPA_PLATFORM=offscreen
ExecStart=/usr/bin/python Main.py -nt
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
