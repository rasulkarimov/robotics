# Python environment & caches
venv/
__pycache__/
*.pyc
*.pyo

# Debug captures & rendered maps (derived output)
*.jpg
*.jpeg
*.png

# ...but reference images (e.g. the robot's own photo) are deliberate, keep them
!docs/*.jpg
!docs/*.jpeg
!docs/*.png

# Derived ORB feature dumps
nav_state/frames/

# Orbit debug output (images + run logs)
orbit_out/
*.log

# Continuous telemetry (ever-growing, no reason to version)
health_log.csv
net_watchdog_log.csv

# Preflight verdicts: one row per safety check, several per training run
safety_log.csv

# Dead-reckoned pose, rewritten on every move
nav_state/pose.json

# rotated pty transcript (the *.log rule does not cover .log.1)
claude_remote_transcript.log.*

# `claude --debug-file` drops a `latest` symlink next to the log it writes
latest

# One row per sound event; telemetry like the others
sound_log.csv
nav_state/room_last/
camera_log.csv

# Aurora930 camera pipeline — compiled binaries (rebuilt by aurora/provision_aurora.sh)
aurora/aurora_streamer
aurora/probe
